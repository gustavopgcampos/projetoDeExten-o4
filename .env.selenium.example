# Copie para .env.selenium. Este arquivo usa somente contas de teste.
SELENIUM_BASE_URL=http://localhost:3000
SELENIUM_ADMIN_EMAIL=
SELENIUM_ADMIN_PASSWORD=
SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=false
SELENIUM_STEP_DELAY=1500
SELENIUM_TIMEOUT=30000
# Necessário para permitir operações de escrita fora de localhost:
SELENIUM_ALLOW_REMOTE=false
# Opcional: executável do Chrome/Brave e servidor Grid
# SELENIUM_CHROME_BINARY=/usr/bin/brave-browser
# SELENIUM_GRID_URL=http://localhost:4444
