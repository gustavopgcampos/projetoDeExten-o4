<main class="auth-page">
  <form class="auth-card" action="/login" method="post">
    <img src="/mmvlteleconlogo.png" alt="MMVL Telecon" class="auth-logo">
    <h1>
      Acesso ao sistema
    </h1>
    <p>
      Entre para gerenciar produtos e orçamentos.
    </p>
    <label>
      E-mail
      <input type="email" name="email" required placeholder="seu@email.com">
    </label>
    <label>
      Senha
      <input type="password" name="password" required placeholder="••••••••">
    </label>
    <button class="button full" type="submit">
      Entrar
    </button>
    <a href="/register" class="center-link">
      Ainda não possui acesso? Criar conta
    </a>
    <a href="/" class="center-link muted">
      Voltar para o início
    </a>
  </form>
</main>
<%- include('../partials/password-toggle') %>
