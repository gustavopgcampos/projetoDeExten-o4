<main class="mx-auto min-h-screen max-w-6xl px-6 pb-12 pt-28">
  <section class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-zinc-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-base font-semibold text-zinc-950">
          Fabricantes
        </h1>
        <p class="text-sm text-zinc-500">
          <%= producers.length %>
          fabricante(s) cadastrado(s)
        </p>
      </div>
      <a href="/dashboard" class="rounded-md border border-zinc-200 px-3 py-2 text-sm hover:bg-zinc-100">
        Voltar aos itens
      </a>
    </div>
    <details class="border-b border-zinc-200 px-5 py-4">
      <summary class="cursor-pointer text-sm text-[#EE4136]">
        Adicionar fabricante
      </summary>
      <form method="post" action="/dashboard/producers" class="mt-3 flex gap-2">
        <input name="name" required maxlength="160" aria-label="Nome do novo fabricante" placeholder="Nome do novo fabricante" class="rounded-md border border-zinc-200 px-3 py-2">
        <button class="rounded-md bg-[#EE4136] px-4 py-2 text-white">
          Adicionar
        </button>
      </form>
    </details>
    <div class="overflow-x-auto">
      <table class="min-w-[700px] w-full text-sm">
        <thead class="bg-zinc-100 text-left text-xs font-semibold uppercase tracking-wide text-zinc-600">
          <tr>
            <th class="px-5 py-3">
              Fabricante
            </th>
            <th class="px-5 py-3">
              Itens vinculados
            </th>
            <th class="px-5 py-3">
              Criado em
            </th>
            <th class="px-5 py-3 text-right">
              Ações
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          <% producers.forEach(producer=>{ %>
            <tr>
              <td class="px-5 py-4 font-medium">
                <%= producer.name %>
              </td>
              <td class="px-5 py-4 text-zinc-700">
                <%= producer.Products?.length || 0 %>
              </td>
              <td class="px-5 py-4 text-zinc-700">
                <%= new Date(producer.createdAt).toLocaleDateString('pt-BR') %>
              </td>
              <td class="px-5 py-4 text-right">
                <form action="/dashboard/producers/<%= producer.id %>/delete" method="post" class="ml-2 inline" onsubmit="return confirm('Excluir este fabricante?')">
                  <button class="rounded-md px-2 py-1 text-sm text-red-600 hover:bg-red-50">
                    Excluir
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
