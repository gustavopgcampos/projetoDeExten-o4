<main class="mx-auto min-h-screen max-w-6xl px-6 pb-12 pt-28"><section class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm"><div class="flex flex-col gap-3 border-b border-zinc-200 px-5 py-4 xl:flex-row xl:items-center xl:justify-between"><div><h1 class="text-base font-semibold text-zinc-950">Catálogo</h1><p class="text-sm text-zinc-500"><%= products.length %> item(ns) encontrado(s)</p></div><div class="flex flex-col gap-2 sm:flex-row sm:items-center"><form method="get" class="flex gap-2"><input name="q" value="<%= q %>" placeholder="Buscar produto, categoria ou fabricante" class="h-9 w-72 rounded-md border border-zinc-200 px-3 text-sm outline-none focus:border-[#EE4136]"><button class="h-9 rounded-md border border-zinc-200 px-3 text-sm hover:bg-zinc-100">Buscar</button></form><button onclick="openProductModal()" class="inline-flex h-9 items-center rounded-md bg-[#EE4136] px-3 text-sm font-medium text-white hover:bg-[#c13026]">＋ Adicionar</button><button onclick="document.getElementById('bulk-delete').submit()" class="inline-flex h-9 items-center rounded-md border border-zinc-200 px-3 text-sm hover:bg-zinc-100">Excluir selecionados</button></div></div><form id="bulk-delete" method="post" action="/dashboard/products/bulk-delete"></form><div class="overflow-x-auto"><table class="min-w-[1080px] w-full text-sm"><thead class="bg-zinc-100 text-left text-xs font-semibold uppercase tracking-wide text-zinc-600"><tr><th class="px-5 py-3"><input type="checkbox" onclick="document.querySelectorAll('.product-check').forEach(x=>x.checked=this.checked)"></th><th class="px-5 py-3">Produto</th><th class="px-5 py-3">Categoria</th><th class="px-5 py-3">Fabricante</th><th class="px-5 py-3">Tipo</th><th class="px-5 py-3">Valor unitário</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Criado em</th><th class="px-5 py-3 text-right">Ações</th></tr></thead><tbody class="divide-y divide-zinc-100"><% if(products.length){ products.forEach(product=>{ %><tr class="hover:bg-zinc-50"><td class="px-5 py-4"><input form="bulk-delete" class="product-check" name="productIds" value="<%= product.id %>" type="checkbox"></td><td class="px-5 py-4 font-medium"><%= product.productName %></td><td class="px-5 py-4 text-zinc-700"><%= categoryLabels[product.category] %></td><td class="px-5 py-4 text-zinc-700"><%= product.Producer?.name || 'Sem fabricante' %></td><td class="px-5 py-4 text-zinc-700"><%= product.detail %></td><td class="px-5 py-4 font-medium"><%= formatMoney(product.unitValue) %></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs <%= product.status==='ACTIVE'?'bg-emerald-50 text-emerald-700':'bg-zinc-100 text-zinc-600' %>"><%= product.status==='ACTIVE'?'Ativo':'Inativo' %></span></td><td class="px-5 py-4 text-zinc-700"><%= new Date(product.createdAt).toLocaleDateString('pt-BR') %></td><td class="px-5 py-4 text-right"><button onclick='editProduct(<%- JSON.stringify(product) %>)' class="mr-2 text-zinc-600 hover:text-zinc-950">✎</button><form class="inline" action="/dashboard/products/<%= product.id %>/delete" method="post" onsubmit="return confirm('Excluir este item?')"><button class="text-zinc-600 hover:text-red-700">⌫</button></form></td></tr><% }) } else { %><tr><td colspan="9" class="px-5 py-12 text-center text-zinc-500">Nenhum item cadastrado.</td></tr><% } %></tbody></table></div><div class="flex items-center justify-between border-t border-zinc-200 px-5 py-4 text-sm text-zinc-500"><span>Página 1 de 1</span></div></section></main>
<div id="product-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-zinc-950/40 px-4 py-8"><div class="w-full max-w-2xl rounded-lg bg-white shadow-xl"><div class="flex items-center justify-between border-b border-zinc-200 px-5 py-4"><h2 id="modal-title" class="font-semibold">Adicionar item</h2><button onclick="closeProductModal()" class="text-xl text-zinc-500">×</button></div><form id="product-form" method="post" class="grid gap-4 px-5 py-5 sm:grid-cols-2"><label class="grid gap-1.5 text-sm font-medium text-zinc-700">Categoria<select id="category" name="category" class="h-10 rounded-md border border-zinc-200 px-3"><% categories.forEach(c=>{ %><option value="<%= c %>"><%= categoryLabels[c] %></option><% }) %></select></label><label class="grid gap-1.5 text-sm font-medium text-zinc-700">Fabricante<select id="producerId" name="producerId" class="h-10 rounded-md border border-zinc-200 px-3"><option value="">Sem fabricante</option><% producers.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label class="grid gap-1.5 text-sm font-medium text-zinc-700 sm:col-span-2">Produto<input id="productName" name="productName" required class="h-10 rounded-md border border-zinc-200 px-3"></label><label class="grid gap-1.5 text-sm font-medium text-zinc-700">Tipo<input id="detail" name="detail" required class="h-10 rounded-md border border-zinc-200 px-3"></label><label class="grid gap-1.5 text-sm font-medium text-zinc-700">Valor unitário<input id="unitValue" name="unitValue" type="number" min="0" step="0.01" required class="h-10 rounded-md border border-zinc-200 px-3"></label><label class="grid gap-1.5 text-sm font-medium text-zinc-700">Status<select id="status" name="status" class="h-10 rounded-md border border-zinc-200 px-3"><option value="ACTIVE">Ativo</option><option value="INACTIVE">Inativo</option></select></label><div class="flex justify-end gap-2 border-t border-zinc-200 pt-4 sm:col-span-2"><button type="button" onclick="closeProductModal()" class="rounded-md border border-zinc-200 px-3 py-2 text-sm">Cancelar</button><button class="rounded-md bg-[#EE4136] px-3 py-2 text-sm text-white">Salvar</button></div></form></div></div><script>const modal=document.getElementById('product-modal'),form=document.getElementById('product-form');function openProductModal(){document.getElementById('modal-title').textContent='Adicionar item';form.action='/dashboard/products';form.reset();modal.classList.remove('hidden');modal.classList.add('flex')}function editProduct(p){document.getElementById('modal-title').textContent='Editar item';form.action='/dashboard/products/'+p.id+'/edit';for(const key of ['category','producerId','productName','detail','unitValue','status'])document.getElementById(key).value=p[key==='detail'?'detail':key]??'';modal.classList.remove('hidden');modal.classList.add('flex')}function closeProductModal(){modal.classList.add('hidden');modal.classList.remove('flex')}</script>
