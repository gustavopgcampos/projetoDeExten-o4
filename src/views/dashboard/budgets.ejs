<main class="mx-auto min-h-screen max-w-6xl px-6 pb-12 pt-28"><section class="mb-6 rounded-lg border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-200 px-5 py-4"><h1 class="text-xl font-semibold text-zinc-950">Orçamentos</h1><p class="mt-1 text-sm text-zinc-500">Monte e salve orçamentos a partir dos produtos ativos.</p></div><form action="/budgets" method="post" onsubmit="return prepareBudget(this)" class="space-y-5 px-5 py-5"><label class="grid gap-2 text-sm font-medium text-zinc-700">Título<input name="title" placeholder="Ex.: Projeto de conectividade" class="h-10 rounded-md border border-zinc-200 px-3 font-normal outline-none focus:border-[#EE4136]"></label><div id="budget-items" class="overflow-hidden rounded-md border border-zinc-200"></div><div class="flex flex-wrap items-center justify-between gap-3"><button type="button" onclick="addBudgetItem()" class="rounded-md border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 hover:border-[#EE4136] hover:text-[#EE4136]">＋ Adicionar item</button><button class="rounded-md bg-[#EE4136] px-4 py-2 text-sm font-medium text-white hover:bg-[#c13026]">Salvar orçamento</button></div><input type="hidden" name="items" id="items-json"></form></section><section class="rounded-lg border border-zinc-200 bg-white shadow-sm"><div class="border-b border-zinc-200 px-5 py-4"><h2 class="text-lg font-semibold text-zinc-950">Orçamentos antigos</h2></div><% if(!budgets.length){ %><p class="px-5 py-8 text-sm text-zinc-500">Nenhum orçamento salvo ainda.</p><% } else { %><div class="divide-y divide-zinc-200"><% budgets.forEach(budget=>{ %><article class="px-5 py-5"><div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between"><div><h3 class="font-semibold text-zinc-950"><%= budget.title %></h3><p class="mt-1 text-sm text-zinc-500"><%= new Date(budget.createdAt).toLocaleDateString('pt-BR') %> — <%= budget.BudgetItems?.length || 0 %> item(ns)</p></div><div class="flex flex-col gap-3 md:items-end"><p class="text-lg font-semibold text-[#EE4136]"><%= formatMoney(budget.totalValue) %></p><form action="/budgets/<%= budget.id %>/delete" method="post"><button class="rounded-md border border-red-200 px-3 py-2 text-sm text-red-600 hover:bg-red-50">Excluir</button></form></div></div><div class="mt-4 overflow-hidden rounded-md border border-zinc-200"><div class="grid grid-cols-4 gap-3 bg-zinc-50 px-4 py-3 text-xs font-semibold uppercase text-zinc-500"><span>Produto</span><span>Categoria</span><span>Qtd.</span><span>Total</span></div><% (budget.BudgetItems||[]).forEach(item=>{ %><div class="grid grid-cols-4 gap-3 border-t border-zinc-200 px-4 py-3 text-sm"><span class="font-medium"><%= item.productName %></span><span><%= categoryLabels[item.category] %></span><span><%= item.quantity %></span><span class="font-semibold"><%= formatMoney(item.totalValue) %></span></div><% }) %></div></article><% }) %></div><% } %></section></main><script>const products=<%- JSON.stringify(products.map(p=>({id:p.id,name:p.productName,category:categoryLabels[p.category],value:Number(p.unitValue)}))) %>;let budgetItems=[];function addBudgetItem(){const index=budgetItems.length;budgetItems.push({productId:products[0]?.id,quantity:1,markup:0});const row=document.createElement('div');row.className='grid gap-3 border-b border-zinc-200 px-4 py-4 md:grid-cols-[minmax(220px,1fr)_90px_120px_120px]';row.innerHTML='<select class="rounded-md border border-zinc-300 px-3 py-2 text-sm" onchange="budgetItems['+index+'].productId=this.value">'+products.map(p=>'<option value="'+p.id+'">'+p.name+' — '+p.category+'</option>').join('')+'</select><input class="rounded-md border border-zinc-300 px-3 py-2 text-sm" type="number" min="1" value="1" onchange="budgetItems['+index+'].quantity=this.value"><input class="rounded-md border border-zinc-300 px-3 py-2 text-sm" type="number" min="0" step=".01" value="0" placeholder="%" onchange="budgetItems['+index+'].markup=this.value"><span class="py-2 text-sm text-zinc-500">'+(products[0]?products[0].value.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}):'')+'</span>';document.getElementById('budget-items').appendChild(row)}function prepareBudget(form){document.getElementById('items-json').value=JSON.stringify(budgetItems);return budgetItems.length>0}</script>
